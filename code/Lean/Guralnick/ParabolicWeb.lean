import Guralnick.SphericalMaps
import Guralnick.SphericalMergeConstruction
import Guralnick.FiniteSymmetrizerEigen
import Guralnick.FiniteSymmetrizerAbsorption
import Guralnick.CanonicalHecke

/-!
# The actual parabolics of the six-map web

Parabolics are the subgroups generated by specified simple reflections in
the actual affine group. Finiteness and longest elements are constructed in
`ElementaryCoxeterParabolic`. Generator eigenvalues and integral merges
are derived below; the remaining parabolic laws are explicit hypotheses. The index
sets for this manuscript, their inclusions, and the resulting six-map
numerator identity are proved here. No canonical correction, gallery count
or row-sum formula is included in the input.
-/

noncomputable section
namespace Guralnick.ParabolicWeb
open scoped BigOperators
open Hecke

def Index (n : ℕ) := {I : Finset (Fin n) // I ≠ Finset.univ}

def subgroup {n : ℕ} (c : WindowCoxeter n) (I : Index n) :
    Subgroup (AffinePermutation n) :=
  Subgroup.closure (c.system.simple '' (I.val : Set (Fin n)))

/-- General finitary-parabolic data, before any family-specific index is chosen. -/
structure LongestData {n : ℕ} (c : WindowCoxeter n) (I : Index n) where
  finite : Finite (subgroup c I)
  longest : subgroup c I
  length_max : ∀ w : subgroup c I,
    c.system.length w.val ≤ c.system.length longest.val

variable {n : ℕ} {c : WindowCoxeter n} (K : KLRealization c)
variable (D : ∀ I : Index n, LongestData c I)

def symmetrizer (I : Index n) : Hecke.Algebra n := K.canonical (D I).longest.val

/-- The actual finite-parabolic Poincaré scalar in the paper's normalization. -/
def scalar (I : Index n) : R :=
  letI : Finite (subgroup c I) := (D I).finite
  letI := Fintype.ofFinite (subgroup c I)
  ∑ w : subgroup c I,
    LaurentPolynomial.T ((c.system.length (D I).longest.val : ℤ) -
      2 * c.system.length w.val)

/-- At v=1 the defining Poincare sum is the cardinality of the actual
finite parabolic subgroup. In particular the scalar cannot vanish. -/
theorem scalar_ne_zero (I : Index n) : scalar D I≠0 := by
  classical
  letI : Finite (subgroup c I):=(D I).finite
  letI := Fintype.ofFinite (subgroup c I)
  intro h
  have he:=congrArg (LaurentPolynomial.eval₂ (RingHom.id ℤ) (1 : ℤˣ)) h
  have hz : (Fintype.card (subgroup c I) : ℤ)=0 := by
    simpa [scalar,map_sum,LaurentPolynomial.eval₂_T] using he
  have hp : 0<(Fintype.card (subgroup c I) : ℤ) := by
    exact_mod_cast Fintype.card_pos (α:=subgroup c I)
  omega

/-- General parabolic symmetrizer/induced-module results (Cui's Hecke
realization and the parabolic Schur composition normalization). These
hold for every inclusion of proper finite parabolics, not just this web. -/
structure Laws : Prop where
  standard_sum : ∀ I : Index n,
    letI : Finite (subgroup c I) := (D I).finite
    letI := Fintype.ofFinite (subgroup c I)
    symmetrizer K D I = ∑ w : subgroup c I,
      (LaurentPolynomial.T ((c.system.length (D I).longest.val : ℤ) -
        c.system.length w.val) : R) • K.standard w.val
  inclusion : ∀ I J : Index n, I.val ⊆ J.val →
    SphericalMaps.spherical (symmetrizer K D J) ≤
      SphericalMaps.spherical (symmetrizer K D I)

namespace Laws
variable {K D}

theorem left_eigen (L : Laws K D) (I : Index n) (i : Fin n) (hi : i ∈ I.val) :
    H i * symmetrizer K D I = (LaurentPolynomial.T (-1) : R) • symmetrizer K D I := by
  letI : Finite (subgroup c I) := (D I).finite
  letI := Fintype.ofFinite (subgroup c I)
  rw [L.standard_sum]
  exact FiniteSymmetrizerEigen.left_eigen K (subgroup c I) _ i
    (Subgroup.subset_closure ⟨i,hi,rfl⟩)

theorem right_eigen (L : Laws K D) (I : Index n) (i : Fin n) (hi : i ∈ I.val) :
    symmetrizer K D I * H i = (LaurentPolynomial.T (-1) : R) • symmetrizer K D I := by
  letI : Finite (subgroup c I) := (D I).finite
  letI := Fintype.ofFinite (subgroup c I)
  rw [L.standard_sum]
  exact FiniteSymmetrizerEigen.right_eigen K (subgroup c I) _ i
    (Subgroup.subset_closure ⟨i,hi,rfl⟩)

/-- Absorption follows by multiplying the actual standard sum, using
generator eigenvalues and the two Hecke multiplication cases. -/
theorem absorption (L : Laws K D) (I J : Index n) (h : I.val ⊆ J.val) :
    symmetrizer K D J * symmetrizer K D I = scalar D I • symmetrizer K D J := by
  letI : Finite (subgroup c I) := (D I).finite
  letI := Fintype.ofFinite (subgroup c I)
  letI : Fintype (Subgroup.closure (c.system.simple '' (I.val : Set (Fin n)))) :=
    inferInstanceAs (Fintype (subgroup c I))
  conv_lhs => rw [L.standard_sum I]
  exact FiniteSymmetrizerEigen.absorption K (I.val : Set (Fin n))
    (symmetrizer K D J) (fun i hi => L.right_eigen J i (h hi)) _

/-- The integral merge descends through the kernel of the smaller
symmetrizer. Nonvanishing, rather than inversion of its Poincare scalar,
is enough. Thus existence of a merge is no additional literature input. -/
theorem merge_exists (L : Laws K D) (I J : Index n) (h : I.val ⊆ J.val) :
    Nonempty (SphericalMaps.Merge (symmetrizer K D I) (symmetrizer K D J)) := by
  refine ⟨SphericalMaps.mergeOfAbsorption (d := scalar D I) ?_ (L.absorption I J h)⟩
  intro x hx
  apply Hecke.scalar_cancel K (ParabolicWeb.scalar_ne_zero D I)
  simpa using hx

/-- API compatibility: nonvanishing is proved from the finite sum and uses
no field of the parabolic-laws input. -/
theorem scalar_ne_zero (_L : Laws K D) (I : Index n) : scalar D I ≠ 0 :=
  ParabolicWeb.scalar_ne_zero D I

/-- Applying bar to C_I^2=h_I C_I forces bar invariance of h_I;
canonical-coordinate extraction performs the cancellation integrally. -/
theorem scalar_bar (L : Laws K D) (I : Index n) : LaurentPolynomial.invert (scalar D I)=scalar D I := by
  have ha:=L.absorption I I (Finset.Subset.refl I.val)
  have hb:=congrArg K.bar ha
  have hc : K.bar (symmetrizer K D I)=symmetrizer K D I := K.bar_canonical _
  rw [map_mul,hc,Hecke.bar_smul,hc,ha] at hb
  have hd:=congrArg (fun x : Hecke.Algebra n => K.canonical.repr x (D I).longest.val) hb
  simp [symmetrizer] at hd
  exact hd.symm

end Laws

namespace Family

def sourceSet (m : ℕ) : Finset (Fin (2 * m + 1)) :=
  Finset.univ.filter fun i => i.val ≠ 0

def cyclicSet (m : ℕ) : Finset (Fin (2 * m + 1)) :=
  Finset.univ.filter fun i => i.val ≠ m ∧ i.val ≠ m + 1

def middleSet (m : ℕ) : Finset (Fin (2 * m + 1)) :=
  Finset.univ.filter fun i => i.val ≠ 0 ∧ i.val ≠ 1 ∧ i.val ≠ 2 * m

def outputSet (m : ℕ) := sourceSet m ∩ cyclicSet m
def commonSet (m : ℕ) := cyclicSet m ∩ middleSet m

theorem source_proper (m : ℕ) : sourceSet m ≠ Finset.univ := by
  intro h
  have hh := Finset.mem_univ (⟨0, by omega⟩ : Fin (2 * m + 1))
  rw [← h] at hh
  simpa [sourceSet] using hh

theorem cyclic_proper (m : ℕ) : cyclicSet m ≠ Finset.univ := by
  intro h
  have hh := Finset.mem_univ (⟨m, by omega⟩ : Fin (2 * m + 1))
  rw [← h] at hh
  simpa [cyclicSet] using hh

theorem middle_subset_source (m : ℕ) : middleSet m ⊆ sourceSet m := by
  intro i hi
  simp only [middleSet, sourceSet, Finset.mem_filter, Finset.mem_univ, true_and] at *
  exact hi.1

theorem output_proper (m : ℕ) : outputSet m ≠ Finset.univ := by
  intro h
  apply source_proper m
  apply Finset.eq_univ_of_forall
  intro i
  have hi : i ∈ outputSet m := h ▸ Finset.mem_univ i
  exact Finset.mem_of_mem_inter_left hi

theorem middle_proper (m : ℕ) : middleSet m ≠ Finset.univ := by
  intro h
  apply source_proper m
  apply Finset.eq_univ_of_forall
  intro i
  exact middle_subset_source m (h ▸ Finset.mem_univ i)

theorem common_proper (m : ℕ) : commonSet m ≠ Finset.univ := by
  intro h
  apply cyclic_proper m
  apply Finset.eq_univ_of_forall
  intro i
  have hi : i ∈ commonSet m := h ▸ Finset.mem_univ i
  exact Finset.mem_of_mem_inter_left hi

def source (m : ℕ) : Index (2 * m + 1) := ⟨sourceSet m, source_proper m⟩
def cyclic (m : ℕ) : Index (2 * m + 1) := ⟨cyclicSet m, cyclic_proper m⟩
def middle (m : ℕ) : Index (2 * m + 1) := ⟨middleSet m, middle_proper m⟩
def output (m : ℕ) : Index (2 * m + 1) := ⟨outputSet m, output_proper m⟩
def common (m : ℕ) : Index (2 * m + 1) := ⟨commonSet m, common_proper m⟩

theorem output_source (m : ℕ) : (output m).val ⊆ (source m).val :=
  Finset.inter_subset_left
theorem output_cyclic (m : ℕ) : (output m).val ⊆ (cyclic m).val :=
  Finset.inter_subset_right
theorem common_cyclic (m : ℕ) : (common m).val ⊆ (cyclic m).val :=
  Finset.inter_subset_left
theorem common_middle (m : ℕ) : (common m).val ⊆ (middle m).val :=
  Finset.inter_subset_right

theorem common_output (m : ℕ) : (common m).val ⊆ (output m).val := by
  intro i hi
  obtain ⟨hj, hk⟩ := Finset.mem_inter.mp hi
  exact Finset.mem_inter.mpr ⟨middle_subset_source m hk, hj⟩

variable {m : ℕ} {c : WindowCoxeter (2 * m + 1)} (K : KLRealization c)
variable (D : ∀ I : Index (2 * m + 1), LongestData c I) (L : Laws K D)

def sixMaps : SphericalMaps.SixMaps
    (symmetrizer K D (source m)) (symmetrizer K D (output m))
    (symmetrizer K D (cyclic m)) (symmetrizer K D (common m))
    (symmetrizer K D (middle m)) where
  source_inclusion := L.inclusion _ _ (output_source m)
  cyclic_inclusion := L.inclusion _ _ (common_cyclic m)
  middle_inclusion := L.inclusion _ _ (common_middle m)
  cyclic_merge := Classical.choice (L.merge_exists _ _ (output_cyclic m))
  middle_merge := Classical.choice (L.merge_exists _ _ (common_middle m))
  output_merge := Classical.choice (L.merge_exists _ _ (common_output m))

/-- The integral raw element is defined as the composite of the six maps,
not as a quotient and not by its desired standard or canonical coefficients. -/
def raw : Hecke.Algebra (2 * m + 1) :=
  ((sixMaps K D L).result (SphericalMaps.generator (symmetrizer K D (source m)) 1)).val

theorem raw_cleared :
    (scalar D (output m) * scalar D (common m) ^ 2) • raw K D L =
      symmetrizer K D (output m) * symmetrizer K D (middle m) *
        symmetrizer K D (cyclic m) * symmetrizer K D (source m) :=
  (sixMaps K D L).source_cleared_identity _ _
    (L.absorption _ _ (output_cyclic m))
    (L.absorption _ _ (common_middle m))
    (L.absorption _ _ (common_output m))

include L in
theorem denominator_ne_zero :
    scalar D (output m) * scalar D (common m) ^ 2 ≠ 0 :=
  mul_ne_zero (L.scalar_ne_zero _) (pow_ne_zero _ (L.scalar_ne_zero _))

include L in
theorem denominator_bar :
    Positivity.BarSymmetric (scalar D (output m) * scalar D (common m) ^ 2) := by
  unfold Positivity.BarSymmetric
  rw [map_mul, map_pow, L.scalar_bar, L.scalar_bar]

theorem raw_bar : K.bar (raw K D L) = raw K D L := by
  apply Hecke.bar_of_cleared K (denominator_ne_zero K D L) (denominator_bar K D L)
  rw [raw_cleared K D L]
  simp only [map_mul, symmetrizer, K.bar_canonical]

theorem raw_cleared_nonnegative (P : PositivityInput K)
    (w : AffinePermutation (2 * m + 1)) :
    Positivity.Nonnegative ((scalar D (output m) * scalar D (common m) ^ 2) *
      K.canonical.repr (raw K D L) w) :=
  Hecke.cleared_coordinates_nonnegative K P
    (D (output m)).longest.val (D (middle m)).longest.val
    (D (cyclic m)).longest.val (D (source m)).longest.val
    (raw_cleared K D L) w

theorem raw_canonical_bar (w : AffinePermutation (2 * m + 1)) :
    Positivity.BarSymmetric (K.canonical.repr (raw K D L) w) :=
  Hecke.canonical_coordinate_barSymmetric K (raw_bar K D L) w

theorem raw_canonical_support (P : PositivityInput K) :
    (K.canonical.repr (raw K D L)).support ⊆
      (K.standard.repr (raw K D L)).support := by
  apply CanonicalBasis.canonical_support_subset_standard K.standard K.canonical
    (raw K D L) _ (denominator_ne_zero K D L) K.canonical_diagonal P.standard_nonnegative
  intro i _
  exact raw_cleared_nonnegative K D L P i

end Family
end Guralnick.ParabolicWeb
