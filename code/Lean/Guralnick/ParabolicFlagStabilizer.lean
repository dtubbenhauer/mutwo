import Guralnick.ParabolicCosetFactorization
import Guralnick.PolynomialOrbitCounting
import Guralnick.PolynomialCoordinateFlags

/-!
# Actual parabolic stabilizers of canonical partial flags

The subgroup generated by the retained simple reflections is proved to be
the stabilizer of the omitted cyclic cuts. The polynomial lattice statement
then follows from the faithful integer monomial basis and the literal
periodic permutation action; it is not an orbit-classification premise.
-/

noncomputable section
namespace Guralnick.ParabolicFlagStabilizer
open Hecke ParabolicWeb ElementaryCoxeterParabolic ElementaryCoxeterCutLength
open ElementaryCoxeterRotation ElementaryCoxeterLongest ParabolicCosetFactorization

variable {n : ℕ}

/-- Changing the cyclic cut changes its lift potential by a coboundary. -/
theorem cutPotential_rotation (a b i : Fin n) :
    cutPotential (cutEquiv a b) (cutEquiv a i) =
      cutPotential b i-cutPotential a i+cutPotential a b := by
  have ha := a.isLt
  have hb := b.isLt
  have hi := i.isLt
  change cutPotential (cutRank a b) (cutRank a i) = _
  simp only [cutPotential,cutRank]
  split_ifs <;> omega

/-- Rotation transports every actual cut stabilizer. -/
theorem rotation_mem_cut_of_mem (a b : Fin n) (w : AffinePermutation n)
    (h : w∈cutSubgroup b) : rotation a w ∈ cutSubgroup (cutEquiv a b) := by
  intro r
  obtain ⟨i,rfl⟩ := (cutEquiv a).surjective r
  change (gauge (cutEquiv a) (cutPotential a) w).winding (cutEquiv a i) =
    cutPotential (cutEquiv a b)
      ((gauge (cutEquiv a) (cutPotential a) w).residue (cutEquiv a i)) -
      cutPotential (cutEquiv a b) (cutEquiv a i)
  rw [gauge_winding,gauge_residue,cutPotential_rotation,cutPotential_rotation,h i]
  ring

/-- Every omitted cut forces preservation of its packet boundary. -/
theorem label_preserved_of_cuts [NeZero n] (a : Fin n) (I : Index n)
    (ha : a∉I.val) (w : AffinePermutation n)
    (hcuts : ∀ b, b∉I.val → w∈cutSubgroup b) (i : Fin n) :
    label a I ((rotation a w).residue i)=label a I i := by
  have hw := rotation_zero_winding a w (hcuts a ha)
  apply congrArg Finset.card
  apply Finset.ext
  intro r
  simp only [Finset.mem_filter]
  apply and_congr_right
  intro hr
  obtain ⟨b,hb,rfl⟩ := Finset.mem_image.mp hr
  have hc := rotation_mem_cut_of_mem a b w (hcuts b (Finset.mem_compl.mp hb))
  have he := hc i
  rw [hw] at he
  simp only [Pi.zero_apply,cutPotential] at he
  change (cutEquiv a b).val ≤ ((rotation a w).residue i).val ↔
    (cutEquiv a b).val ≤ i.val
  split_ifs at he <;> omega

/-- A cut-preserving affine window with no selected descent is the identity. -/
theorem eq_one_of_cuts_no_descents (c : WindowCoxeter n) (I : Index n)
    (w : AffinePermutation n) (hcuts : ∀ a, a∉I.val → w∈cutSubgroup a)
    (hno : ∀ s∈I.val, ¬c.system.IsRightDescent w s) : w=1 := by
  obtain ⟨a,ha⟩ := exists_omitted I
  letI : NeZero n := ⟨Nat.ne_of_gt (Fin.pos a)⟩
  have hw := rotation_zero_winding a w (hcuts a ha)
  let σ := (rotation a w).residue
  have hσ : StrictMono σ := by
    intro i j hij
    by_cases hp : label a I i=label a I j
    · have h := increasing_on_label c a I w hno i j hij hp
      simpa [AffinePermutation.entry,hw] using h
    · have hp' : label a I i<label a I j :=
        lt_of_le_of_ne (label_monotone a I (le_of_lt hij)) hp
      by_contra h
      have hle := label_monotone a I (le_of_not_gt h)
      change label a I ((rotation a w).residue j) ≤ label a I ((rotation a w).residue i) at hle
      rw [label_preserved_of_cuts a I ha w hcuts,
        label_preserved_of_cuts a I ha w hcuts] at hle
      exact (not_le_of_gt hp') hle
  have he : (σ : Fin n → Fin n)=id := (hσ.range_inj strictMono_id).mp (by
    rw [σ.surjective.range_eq]
    exact Set.range_id.symm)
  apply (rotation a).injective
  rw [map_one]
  apply AffinePermutation.ext
  · apply Equiv.ext
    intro i
    exact congrFun he i
  · exact hw

/-- The generated parabolic is exactly the intersection of the omitted-cut
stabilizers. The converse is proved by descent, not assumed from a building. -/
theorem mem_subgroup_iff_cuts (c : WindowCoxeter n) (I : Index n)
    (w : AffinePermutation n) :
    w∈subgroup c I ↔ ∀ a, a∉I.val → w∈cutSubgroup a := by
  constructor
  · intro hw a ha
    exact subgroup_le_cut c I a ha hw
  · intro hcuts
    have aux (r : ℕ) : ∀ w : AffinePermutation n, c.system.length w=r →
        (∀ a, a∉I.val → w∈cutSubgroup a) → w∈subgroup c I := by
      induction r using Nat.strong_induction_on with
      | h r ih =>
        intro w hw hcuts
        by_cases hone : w=1
        · subst w; exact (subgroup c I).one_mem
        · have hex : ∃ s∈I.val,c.system.IsRightDescent w s := by
            by_contra h
            push_neg at h
            exact hone (eq_one_of_cuts_no_descents c I w hcuts h)
          obtain ⟨s,hs,hd⟩ := hex
          have hs' : c.system.simple s∈subgroup c I := Subgroup.subset_closure ⟨s,hs,rfl⟩
          have hv : ∀ a, a∉I.val → w*c.system.simple s∈cutSubgroup a := by
            intro a ha
            exact (cutSubgroup a).mul_mem (hcuts a ha) (subgroup_le_cut c I a ha hs')
          have hvlen := c.system.isRightDescent_iff.mp hd
          have hmem := ih (c.system.length (w*c.system.simple s)) (by omega)
            (w*c.system.simple s) rfl hv
          simpa only [c.system.simple_mul_simple_cancel_right] using (subgroup c I).mul_mem hmem hs'
    exact aux _ w rfl hcuts

/-- The integral cut inequality in one selected fundamental interval. -/
theorem index_le_residue_cut_iff [NeZero n] (a i : Fin n) (q : ℤ) :
    AffinePermutation.integerIndex n (i,q) ≤ (a.val : ℤ) ↔
      q < cutPotential a i := by
  rw [PolynomialOrbitCounting.index_le_cut_iff n,OrbitMatrix.cutLevel_nat n a.val (le_of_lt a.isLt)]
  change q+1 ≤ (if i.val<a.val then (1 : ℤ) else 0) ↔
    q < (if i.val<a.val then (1 : ℤ) else 0)
  omega

/-- The winding-potential equation is exactly preservation of the integer
half-line below the chosen cut. -/
theorem mem_cut_iff_halfLine [NeZero n] (a : Fin n) (w : AffinePermutation n) :
    w∈cutSubgroup a ↔ ∀ z : ℤ, w.onIntegers z ≤ (a.val : ℤ) ↔ z ≤ (a.val : ℤ) := by
  have hwindow (i : Fin n) (q : ℤ) :
      w.onIntegers (AffinePermutation.integerIndex n (i,q)) ≤ (a.val : ℤ) ↔
        q+w.winding i < cutPotential a (w.residue i) := by
    rw [AffinePermutation.onIntegers_index]
    exact index_le_residue_cut_iff a (w.residue i) (q+w.winding i)
  constructor
  · intro hw z
    obtain ⟨⟨i,q⟩,rfl⟩ := (AffinePermutation.integerIndex n).surjective z
    rw [hwindow,index_le_residue_cut_iff,hw i]
    omega
  · intro hw i
    have ht (q : ℤ) : q+w.winding i < cutPotential a (w.residue i) ↔
        q < cutPotential a i := by
      rw [←hwindow,←index_le_residue_cut_iff]
      exact hw _
    have hlo := (ht (cutPotential a i-1)).mpr (by omega)
    have hhi : ¬cutPotential a i+w.winding i<cutPotential a (w.residue i) := by
      intro h
      have := (ht (cutPotential a i)).mp h
      omega
    change w.winding i=cutPotential a (w.residue i)-cutPotential a i
    omega

/-- Equality of the actual polynomial cut subspaces detects the subgroup
cut condition, by the faithful integer monomial basis. -/
theorem sourceCut_eq_targetCut_iff (k : Type) [Field k] [NeZero n]
    (a : Fin n) (w : AffinePermutation n) :
    PolynomialOrbitCoordinates.sourceCut k n w a.val =
      PolynomialOrbitCoordinates.targetCut k n a.val ↔ w∈cutSubgroup a := by
  rw [mem_cut_iff_halfLine]
  constructor
  · intro h z
    have hf := (PolynomialOrbitCounting.source_le_target k n w a.val a.val).mp h.le
    have hb := (PolynomialOrbitCounting.target_le_source k n w a.val a.val).mp h.ge
    constructor
    · intro hz
      simpa only [Equiv.symm_apply_apply] using hb (w.onIntegers z) hz
    · exact hf z
  · intro h
    apply le_antisymm
    · apply (PolynomialOrbitCounting.source_le_target k n w a.val a.val).mpr
      intro z hz
      exact (h z).mpr hz
    · apply (PolynomialOrbitCounting.target_le_source k n w a.val a.val).mpr
      intro z hz
      apply (h (w.onIntegers.symm z)).mp
      simpa only [Equiv.apply_symm_apply] using hz

/-- The cut-module and coordinate-module definitions agree at every
retained residue, with their original one-based integer convention. -/
theorem cutModule_residue (k : Type) [Field k] [NeZero n] (a : Fin n) :
    PolynomialOrbitCoordinates.cutModule k n a.val =
      PolynomialAffineCoordinates.coordinateModule k n a.val := by
  unfold PolynomialOrbitCoordinates.cutModule PolynomialAffineCoordinates.coordinateModule
  simp_rw [OrbitMatrix.cutLevel_nat n a.val (le_of_lt a.isLt)]

/-- Literal canonical polynomial modules detect the same cut stabilizer. -/
theorem coordinateModule_fixed_iff (k : Type) [Field k] [NeZero n]
    (a : Fin n) (w : AffinePermutation n) :
    PolynomialAffineCoordinates.mapModule k n (PolynomialAffineCoordinates.windowEquiv k n w)
        (PolynomialAffineCoordinates.coordinateModule k n a.val) =
      PolynomialAffineCoordinates.coordinateModule k n a.val ↔ w∈cutSubgroup a := by
  rw [←sourceCut_eq_targetCut_iff k a w]
  change _ ↔
    (PolynomialAffineCoordinates.mapModule k n (PolynomialAffineCoordinates.windowEquiv k n w)
      (PolynomialOrbitCoordinates.cutModule k n a.val)).restrictScalars k =
        (PolynomialOrbitCoordinates.cutModule k n a.val).restrictScalars k
  rw [cutModule_residue,Submodule.restrictScalars_inj]

/-- Equality of canonical partial flags is detected by the generated
parabolic, for any flags with the stated literal coordinate modules. -/
theorem partial_eq_iff_of_nodes (k : Type) [Field k] [NeZero n]
    (c : WindowCoxeter n) (I : Index n) (w : AffinePermutation n)
    (source target : PolynomialFlags.Flag k n (LatticeFlags.retained I))
    (hs : ∀ i, (source.node i).module =
      PolynomialAffineCoordinates.mapModule k n (PolynomialAffineCoordinates.windowEquiv k n w)
        (PolynomialAffineCoordinates.coordinateModule k n i.val.val))
    (ht : ∀ i, (target.node i).module =
      PolynomialAffineCoordinates.coordinateModule k n i.val.val) :
    source=target ↔ w∈subgroup c I := by
  rw [mem_subgroup_iff_cuts]
  constructor
  · intro h a ha
    have hamem : a∈LatticeFlags.retained I := Finset.mem_compl.mpr ha
    have he := congrArg (fun F : PolynomialFlags.Flag k n (LatticeFlags.retained I) =>
      (F.node ⟨a,hamem⟩).module) h
    dsimp only at he
    rw [hs,ht] at he
    exact (coordinateModule_fixed_iff k a w).mp he
  · intro h
    apply PolynomialFlags.Flag.ext
    funext i
    apply PolynomialLattice.Lattice.ext
    rw [hs,ht]
    exact (coordinateModule_fixed_iff k i.val w).mpr
      (h i.val (Finset.mem_compl.mp i.property))

/-- The concrete canonical source and target agree after retaining I's
omitted nodes exactly for windows in the finite parabolic. -/
theorem canonical_partial_eq_iff (k : Type) [Field k] [NeZero n]
    (c : WindowCoxeter n) (I : Index n) (w : AffinePermutation n) :
    PolynomialCoordinateFlags.source k n c w (LatticeFlags.retained I) =
      PolynomialCoordinateFlags.target k n (LatticeFlags.retained I) ↔
        w∈subgroup c I :=
  partial_eq_iff_of_nodes k c I w _ _
    (PolynomialCoordinateFlags.source_node_module k n c w (LatticeFlags.retained I))
    (PolynomialCoordinateFlags.target_node_module k n (LatticeFlags.retained I))

/-- Forgetting nodes in the actual canonical full flags gives exactly the
same subgroup criterion. This is the form used by full-flag convolution. -/
theorem canonical_forget_eq_iff (k : Type) [Field k] [NeZero n]
    (c : WindowCoxeter n) (I : Index n) (w : AffinePermutation n) :
    (PolynomialCoordinateFlags.source k n c w Finset.univ).restrict
        (Finset.subset_univ (LatticeFlags.retained I)) =
      (PolynomialCoordinateFlags.target k n Finset.univ).restrict
        (Finset.subset_univ (LatticeFlags.retained I)) ↔ w∈subgroup c I := by
  apply partial_eq_iff_of_nodes k c I w
  · intro i
    exact PolynomialCoordinateFlags.source_node_module k n c w Finset.univ
      ⟨i.val,Finset.mem_univ _⟩
  · intro i
    exact PolynomialCoordinateFlags.target_node_module k n Finset.univ
      ⟨i.val,Finset.mem_univ _⟩

#print axioms mem_subgroup_iff_cuts
#print axioms coordinateModule_fixed_iff
#print axioms canonical_forget_eq_iff

end Guralnick.ParabolicFlagStabilizer
