import Guralnick.Hecke

/-!
# Integral spherical modules and the six-map numerator

The module generated by `C` is the actual right ideal `{C*h}` inside an
algebra over the Laurent ring. A merge is a linear map on those modules
with its specified action on every generator `C*h`. We prove, without
dividing by any quantum factorial, the cleared product identity for the
manuscript's six maps. The merges are constructed in `SphericalMergeConstruction` from
nonvanishing and absorption; neither merge existence nor the six-map
product identity is an external assumption.
-/

noncomputable section
namespace Guralnick.SphericalMaps

abbrev R := LaurentPolynomial ℤ
variable {A : Type*} [Ring A] [Algebra R A]

/-- The actual cyclic right ideal, regarded as a module over the coefficient ring. -/
def spherical (C : A) : Submodule R A where
  carrier := {x | ∃ h : A, C * h = x}
  zero_mem' := ⟨0, mul_zero C⟩
  add_mem' := by
    rintro x y ⟨h, rfl⟩ ⟨k, rfl⟩
    exact ⟨h + k, mul_add C h k⟩
  smul_mem' := by
    rintro r x ⟨h, rfl⟩
    exact ⟨r • h, by rw [mul_smul_comm]⟩

def generator (C h : A) : spherical C := ⟨C * h, h, rfl⟩

@[simp] theorem generator_val (C h : A) : (generator C h).val = C * h := rfl

theorem right_closed (C : A) (x : spherical C) (h : A) :
    x.val * h ∈ spherical C := by
  obtain ⟨k, hk⟩ := x.property
  exact ⟨k * h, by rw [← mul_assoc, hk]⟩

/-- The specified finite-parabolic merge `C_L*h ↦ C_P*h`. Its existence
is constructed by kernel descent in `SphericalMergeConstruction`. -/
structure Merge (C_L C_P : A) where
  linear : spherical C_L →ₗ[R] spherical C_P
  on_generator : ∀ h : A, (linear (generator C_L h)).val = C_P * h

/-- Clear a merge denominator inside the integral algebra. -/
theorem merge_cleared {C_L C_P : A} (f : Merge C_L C_P) (d : R)
    (hpar : C_P * C_L = d • C_P) (x : spherical C_L) :
    d • (f.linear x).val = C_P * x.val := by
  obtain ⟨h, hh⟩ := x.property
  have hx : x = generator C_L h := Subtype.ext hh.symm
  rw [hx, f.on_generator, generator_val, ← mul_assoc, hpar, smul_mul_assoc]

/-- The source, cyclic vertex and two intermediate finite-parabolic modules
are connected by exactly the three inclusions and three merges in §3. -/
structure SixMaps (C₀ C_V C_J C_L C_K : A) where
  source_inclusion : spherical C₀ ≤ spherical C_V
  cyclic_inclusion : spherical C_J ≤ spherical C_L
  middle_inclusion : spherical C_K ≤ spherical C_L
  cyclic_merge : Merge C_V C_J
  middle_merge : Merge C_L C_K
  output_merge : Merge C_L C_V

namespace SixMaps
variable {C₀ C_V C_J C_L C_K : A} (f : SixMaps C₀ C_V C_J C_L C_K)

def stageJ (x : spherical C₀) : spherical C_J :=
  f.cyclic_merge.linear (Submodule.inclusion f.source_inclusion x)

def stageK (x : spherical C₀) : spherical C_K :=
  f.middle_merge.linear (Submodule.inclusion f.cyclic_inclusion (f.stageJ x))

def result (x : spherical C₀) : spherical C_V :=
  f.output_merge.linear (Submodule.inclusion f.middle_inclusion (f.stageK x))

def linear : spherical C₀ →ₗ[R] spherical C_V :=
  f.output_merge.linear.comp ((Submodule.inclusion f.middle_inclusion).comp
    (f.middle_merge.linear.comp ((Submodule.inclusion f.cyclic_inclusion).comp
      (f.cyclic_merge.linear.comp (Submodule.inclusion f.source_inclusion)))))

theorem linear_apply (x : spherical C₀) : f.linear x = f.result x := rfl

/-- The undivided product formula is a theorem about the actual integral
composite. It does not assume that division preserves positivity. -/
theorem cleared_identity (d_V d_L : R)
    (hJ : C_J * C_V = d_V • C_J)
    (hK : C_K * C_L = d_L • C_K)
    (hV : C_V * C_L = d_L • C_V) (x : spherical C₀) :
    (d_V * d_L ^ 2) • (f.result x).val = C_V * C_K * C_J * x.val := by
  have h₁ : d_V • (f.stageJ x).val = C_J * x.val :=
    merge_cleared f.cyclic_merge d_V hJ (Submodule.inclusion f.source_inclusion x)
  have h₂ : d_L • (f.stageK x).val = C_K * (f.stageJ x).val :=
    merge_cleared f.middle_merge d_L hK
      (Submodule.inclusion f.cyclic_inclusion (f.stageJ x))
  have h₃ : d_L • (f.result x).val = C_V * (f.stageK x).val :=
    merge_cleared f.output_merge d_L hV
      (Submodule.inclusion f.middle_inclusion (f.stageK x))
  calc
    (d_V * d_L ^ 2) • (f.result x).val =
        d_V • (d_L • (d_L • (f.result x).val)) := by rw [pow_two, mul_smul, mul_smul]
    _ = d_V • (d_L • (C_V * (f.stageK x).val)) := by rw [h₃]
    _ = C_V * (d_V • (d_L • (f.stageK x).val)) := by
      rw [← mul_smul_comm, ← mul_smul_comm]
    _ = C_V * (d_V • (C_K * (f.stageJ x).val)) := by rw [h₂]
    _ = C_V * (C_K * (d_V • (f.stageJ x).val)) := by rw [← mul_smul_comm]
    _ = C_V * (C_K * (C_J * x.val)) := by rw [h₁]
    _ = C_V * C_K * C_J * x.val := by simp only [mul_assoc]

theorem source_cleared_identity (d_V d_L : R)
    (hJ : C_J * C_V = d_V • C_J)
    (hK : C_K * C_L = d_L • C_K)
    (hV : C_V * C_L = d_L • C_V) :
    (d_V * d_L ^ 2) • (f.result (generator C₀ 1)).val = C_V * C_K * C_J * C₀ := by
  simpa using f.cleared_identity d_V d_L hJ hK hV (generator C₀ 1)

end SixMaps
end Guralnick.SphericalMaps
