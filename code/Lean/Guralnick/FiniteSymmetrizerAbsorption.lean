import Guralnick.FiniteSymmetrizerEigen

/-!
# Absorption from the elementary generator eigenvalues

Membership in the subgroup generated by simple reflections is converted
to induction by those generators. This works with nonreduced words: the
quadratic relation handles every descent. No parabolic word theorem or
absorption formula is an input.
-/
noncomputable section
namespace Guralnick.FiniteSymmetrizerEigen
open Hecke HeckeInversion
open scoped BigOperators
variable {n : ℕ} {c : WindowCoxeter n} (K : KLRealization c)

theorem generators_monoid (I : Set (Fin n)) :
    (Subgroup.closure (c.system.simple '' I)).toSubmonoid =
      Submonoid.closure (c.system.simple '' I) := by
  rw [Subgroup.closure_toSubmonoid]
  congr 1
  apply Set.union_eq_self_of_subset_right
  rintro w hw
  have h : w⁻¹∈c.system.simple '' I := hw
  obtain ⟨i,hi,he⟩ := h
  refine ⟨i,hi,?_⟩
  simpa only [c.system.inv_simple,inv_inv] using congrArg Inv.inv he

theorem right_standard_step (x : Hecke.Algebra n) (i : Fin n)
    (hx : x*H i=(LaurentPolynomial.T (-1) : R) • x)
    (w : AffinePermutation n)
    (hw : x*K.standard w=(LaurentPolynomial.T (-(c.system.length w : ℤ)) : R) • x) :
    x*K.standard (c.system.simple i*w)=
      (LaurentPolynomial.T (-(c.system.length (c.system.simple i*w) : ℤ)) : R) • x := by
  rcases c.system.length_simple_mul w i with h|h
  · rw [←left_ascent K w i h,←mul_assoc,hx,smul_mul_assoc,hw,smul_smul,
      ←LaurentPolynomial.T_add,h,Nat.cast_add,Nat.cast_one]
    congr 2
    ring
  · have he := congrArg (fun y : Hecke.Algebra n => x*y) (left_descent K w i h)
    dsimp only at he
    rw [mul_add,mul_smul_comm,←mul_assoc,hx,smul_mul_assoc,hw,smul_smul,smul_smul] at he
    have hlen : -(c.system.length (c.system.simple i*w) : ℤ)=1-(c.system.length w : ℤ) := by omega
    have hp : (LaurentPolynomial.T (-(c.system.length (c.system.simple i*w) : ℤ)) : R) • x +
        (((LaurentPolynomial.T (-1) : R)-LaurentPolynomial.T 1)*
          LaurentPolynomial.T (-(c.system.length w : ℤ))) • x =
        ((LaurentPolynomial.T (-1) : R)*LaurentPolynomial.T (-(c.system.length w : ℤ))) • x := by
      rw [←add_smul,hlen,show 1-(c.system.length w : ℤ)=1+(-(c.system.length w : ℤ)) by ring,
        LaurentPolynomial.T_add]
      congr 1
      ring
    apply K.standard.repr.injective
    have hc := congrArg K.standard.repr (he.symm.trans hp.symm)
    simp only [map_add] at hc
    exact add_right_cancel hc

theorem right_standard_of_generators (I : Set (Fin n)) (x : Hecke.Algebra n)
    (hx : ∀ i∈I, x*H i=(LaurentPolynomial.T (-1) : R) • x)
    (w : AffinePermutation n) (hw : w∈Subgroup.closure (c.system.simple '' I)) :
    x*K.standard w=(LaurentPolynomial.T (-(c.system.length w : ℤ)) : R) • x := by
  have hm : w∈Submonoid.closure (c.system.simple '' I) := by
    rw [←generators_monoid (c:=c) I]
    exact hw
  apply Submonoid.closure_induction_left
    (p := fun w _ => x*K.standard w=(LaurentPolynomial.T (-(c.system.length w : ℤ)) : R) • x)
    ?_ ?_ hm
  · simp [standard_one]
  · rintro _ ⟨i,hi,rfl⟩ w _ ih
    exact right_standard_step K x i (hx i hi) w ih

theorem absorption (I : Set (Fin n))
    [Fintype (Subgroup.closure (c.system.simple '' I))]
    (x : Hecke.Algebra n) (hx : ∀ i∈I, x*H i=(LaurentPolynomial.T (-1) : R) • x)
    (d : ℤ) :
    x*sum K (Subgroup.closure (c.system.simple '' I)) d =
      (∑ w : Subgroup.closure (c.system.simple '' I),
        (LaurentPolynomial.T (d-2*c.system.length w.val) : R)) • x := by
  classical
  unfold sum
  rw [Finset.mul_sum,Finset.sum_smul]
  apply Finset.sum_congr rfl
  intro w _
  rw [mul_smul_comm,right_standard_of_generators K I x hx w.val w.property,
    smul_smul,←LaurentPolynomial.T_add]
  congr 2
  ring

#print axioms absorption
end Guralnick.FiniteSymmetrizerEigen
